# Copy to .env and fill in. Local development values only.
DATABASE_URL=postgresql://localhost/jobsoxo_dev
PORT=5050
APP_URL=http://localhost:5050
SESSION_SECRET=        # openssl rand -hex 32. Required in production (server refuses to start without it).
SETUP_CODE=            # Required to create the first admin on an empty database. Optional locally; production refuses setup without it.
ENCRYPTION_KEY=        # openssl rand -hex 32 (64 hex chars). Production key must be copied exactly.
ENCRYPTION_KEY_PREVIOUS=
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
GUSTO_ENV=demo
GUSTO_API_BASE_URL=
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
GUSTO_ACCESS_TOKEN=
GUSTO_REFRESH_TOKEN=
GUSTO_COMPANY_ID=
GUSTO_WEBHOOK_SECRET=
GUSTO_LIVE_PAYROLL_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=            # e.g. noreply@jobsoxo.com (domain verified in Resend). Unset = noreply@resend.dev, which only delivers to the Resend account owner.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
STRIPE_SECRET_KEY=
ANTHROPIC_API_KEY=      # Invoice assistant + proofreader (Claude). Or use OIDC federation below instead of a key.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=   # or ANTHROPIC_IDENTITY_TOKEN
